[Unit]
Description=Reporch isolated local execution broker
Documentation=https://github.com/Reporch/cli
After=local-fs.target
ConditionPathExists=/usr/lib/reporch/bin/reporch-runtime-service

[Service]
Type=simple
User=root
Group=reporch-runtime
UMask=0007
EnvironmentFile=/etc/reporch/runtime.env
ExecStart=/usr/lib/reporch/bin/reporch-runtime-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillMode=mixed
RuntimeDirectory=reporch-runtime
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
StateDirectory=reporch-runtime
StateDirectoryMode=0750
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
# Firecracker's jailer writes CPU, memory, and PID limits only below this
# service's delegated cgroup subtree. The host filesystem remains protected by
# ProtectSystem=strict and the broker never accepts an arbitrary cgroup path.
ProtectControlGroups=no
Delegate=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/kvm rwm
# Firecracker's jailer always materializes this exact character device before
# dropping privileges, even when the VM config has no network interface. The
# unprivileged VMM receives neither CAP_NET_ADMIN nor a configured NIC.
DeviceAllow=/dev/net/tun rwm
ReadWritePaths=/var/lib/reporch-runtime /run/reporch-runtime /run/user

[Install]
WantedBy=multi-user.target
